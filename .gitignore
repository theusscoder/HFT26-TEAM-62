```gitignore
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies and build output
node_modules/
dist/
dist-ssr/
*.local

# Environment variables and secrets
.env
.env.*
!.env.example

# Local AI coding-agent configuration
.opencode/
opencode.json
opencode.backup.json

# Raw geographic data cache
data/raw/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw*
```