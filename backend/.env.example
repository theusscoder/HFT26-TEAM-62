FEATHERLESS_API_KEY=
FEATHERLESS_TEXT_MODEL=Qwen/Qwen2.5-32B-Instruct
FEATHERLESS_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
TELEGRAM_BOT_TOKEN=
DEMO_CHAT_ID_1=
DEMO_CHAT_ID_2=
# A3 alerts: one demo chat per recipient type (falls back to DEMO_CHAT_ID_1); ntfy is a no-account backup
DEMO_CHAT_ID_HOSPITAL=
DEMO_CHAT_ID_POLICE=
DEMO_CHAT_ID_VICTIM=
DEMO_CHAT_ID_SUSPECT=
NTFY_TOPIC=
# A2 plates: optional YOLO plate-detector weights; OCR uses fast-plate-ocr or easyocr if installed
PLATE_MODEL=
# Demo phone (set by link_telegram.bat). It also stands in for the SUSPECT's registered number; DEMO_SUSPECT_PHONE=off disables that
DEMO_PHONE=
DEMO_SUSPECT_PHONE=
# Live tracking replay speed (10 = one real minute is ten minutes after the incident)
TRACKING_SPEED=10
# Real alerts to the case contacts in data/cases/<id>/contacts.json (set by link_sms.bat / link_telegram.bat)
# SMS: Twilio (trial: verify both numbers first) OR Fast2SMS (India, Quick SMS route)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
FAST2SMS_API_KEY=
# Telegram per number: TG_CHAT_<10 digits>=<chat id>, written when that phone presses START on the bot
TG_CHAT_7330619997=
TG_CHAT_8978777355=
